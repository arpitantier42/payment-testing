# Copy to .env (never commit .env). Used by Alembic and the service.
DATABASE_URL=postgresql+psycopg://payment:payment@localhost:5432/payment

# Base URL the browser uses to reach this service (gateway return URL is built from it).
PUBLIC_BASE_URL=http://localhost:8000

# Server-side only. Never expose to the payment page.
GATEWAY_WEBHOOK_SECRET=change-me
# Optional: X-API-Key the gateway must send on webhook calls.
# GATEWAY_WEBHOOK_API_KEY=

# Dev order-service stub data and static payment page location (defaults shown).
# ORDERS_FILE=dev/orders.json
# WEB_DIR=web/public

# Optional: run the test suite against Postgres instead of SQLite.
# TEST_DATABASE_URL=postgresql+psycopg://payment:payment@localhost:5432/payment_test
